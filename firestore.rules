rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Sistema de reservas de citas de tarot
    match /bookings/{bookingId} {
      // Cualquier persona puede leer (para ver disponibilidad de horarios)
      // y crear nuevas citas (reservas públicas)
      allow read, create: if true;

      // Solo las funciones del servidor (Firebase Admin SDK) pueden
      // actualizar o eliminar citas. El Admin SDK bypassa estas reglas.
      allow update, delete: if false;
    }
  }
}