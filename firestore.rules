rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Sistema de reservas de citas de tarot.
    // El navegador ya no lee ni escribe aquí: la disponibilidad sale de /api/availability
    // (solo horas, sin datos de clientes) y las citas se crean en /api/bookAppointment
    // con el Admin SDK, que no pasa por estas reglas.
    match /bookings/{bookingId} {
      allow read, write: if false;
    }
  }
}
