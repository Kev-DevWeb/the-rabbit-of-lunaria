rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Permite que cualquier persona lea las citas para ver la disponibilidad
    // y cree nuevas citas. Esto es para un sistema de reservas público.
    match /bookings/{bookingId} {
      allow read, create: if true;

      // Para una aplicación en producción, considera reglas más seguras.
      // Por ejemplo, no permitir que nadie actualice o elimine citas.
      allow update, delete: if true;
    }
  }
}